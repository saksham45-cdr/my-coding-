Header linked list --> simple linked list, just the header of it is never empty , we initilise a header pointer that stores the count of nodes , 
whenever a newnode is added , the header -> data is incremented .. 
  #include <iostream> 
using namespace std ;
struct node {
    int data ;
    node* next ;
}
node* header = NULL ;
void initialise (){
    header-> data =0 ;
    header-> next = NULL;
}
void insert ( int x ){
    node* newnode = new node ;
    newnode -> data = x ;
    newnode -> next = NULL;
    
    node* temp = header ;
    while (temp->next != NULL){
        temp = temp-> next ;
    }
    temp-> next = newnode ;
    header-> data ++ ;
    
}
